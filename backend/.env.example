# Supabase (required for API server + trader)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Binance API keys (for --mode real or screener)
API_KEY=
API_SECRET=

# Access code (maps to user in Supabase)
ACCESS_CODE=1231

# Trading config
SYMBOL=SAGAUSDT
LEVERAGE=4
MODE=paper  # paper or real
CONFIG_FILE=
AUTO_SYMBOL=0

# SNN hyperparams
LR=0.01
TAU=24.0
SL=0.05
TP=0.12

# Telegram
TELEGRAM_TOKEN=

# FastAPI server (Fly.io)
PORT=8080
